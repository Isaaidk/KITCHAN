# Copiar como .env y completar con valores reales. No commitear el .env real.

# --- Core / Base de datos ---
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/kitchan

# --- Core / Seguridad (JWT de sesión de KITCHAN) ---
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Correo (recuperación de contraseña) ---
# Cuenta SMTP desde la que salen los códigos de verificación. Con Gmail: activar
# la verificación en dos pasos y crear una "contraseña de aplicación"
# (SMTP_HOST=smtp.gmail.com, SMTP_PORT=587). Si SMTP_HOST queda vacío (desarrollo),
# el código no se envía: aparece en la consola del backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Infraestructura compartida ---
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173

# --- Pedidos ---
# Minutos sin cambios tras los que un pedido NUEVA o EN_PREPARACION se cancela
# solo. Si falta o no es un entero positivo se usan 20.
AUTO_CANCELAR_MINUTOS=20

# --- Integración Odoo (facturación electrónica SRI) ---
# KITCHAN emite la factura en Odoo con la API JSON-2 (Odoo 19) y Odoo la
# firma y la envía al SRI. URL de la instancia, nombre de la base (solo si
# el dominio aloja varias) y API key de un usuario de integración
# (Preferencias > Seguridad de la cuenta > Nueva clave API; dura máx. 3 meses).
ODOO_URL=
ODOO_DB=
ODOO_API_KEY=
# IDs de Odoo con los que se arma la factura: diario de ventas (punto de
# emisión), cliente "Consumidor final" (9999999999999), producto genérico de
# las líneas, impuesto IVA de venta y forma de pago SRI (código 20: otros con
# utilización del sistema financiero).
ODOO_DIARIO_ID=
ODOO_CLIENTE_ID=
ODOO_PRODUCTO_ID=
ODOO_IMPUESTO_ID=
ODOO_PAGO_SRI_ID=
# Token secreto que va en la URL del webhook que configura la regla de
# automatización de Odoo: <KITCHAN>/api/v1/facturacion/odoo/webhook/<token>
ODOO_WEBHOOK_TOKEN=

# --- Integración Uber Eats ---
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_WEBHOOK_SECRET=
UBER_REDIRECT_URI=

# --- Integración PedidosYa (Delivery Hero) ---
# Secreto compartido (HS512) que Delivery Hero entrega para firmar el JWT
# Bearer de cada llamada a nuestro endpoint de dispatch. Es distinto en
# staging y en producción.
PEDIDOSYA_JWT_SECRET=
# Credenciales asignadas durante el alta manual (NDA + formulario con el
# contacto de cuenta de PedidosYa) para las llamadas salientes al
# Integration Middleware API.
# TODO: confirmar el mecanismo real de auth contra pos-middleware-api (se
# asume Basic Auth como placeholder razonable).
PEDIDOSYA_PLUGIN_USERNAME=
PEDIDOSYA_PLUGIN_PASSWORD=
# Dominio del Integration Middleware API. Por defecto usa el de staging
# documentado (integration-middleware.stg.restaurant-partners.com);
# reemplazar por el productivo cuando el contacto de cuenta lo entregue.
PEDIDOSYA_API_BASE=https://integration-middleware.stg.restaurant-partners.com
# Mapeo estático remoteId (elegido por nosotros durante el alta manual) ->
# restaurante_id interno de KITCHAN, en formato JSON.
# Ej: {"POS_RESTAURANT_0001": "11111111-1111-1111-1111-111111111111"}
PEDIDOSYA_REMOTE_ID_MAP={}

# --- Integración WhatsApp (bot independiente en /Whatsapp) ---
# Secreto compartido (HMAC-SHA256) con el bot, en ambos sentidos: el bot firma
# los pedidos que envía al webhook y KITCHAN firma los avisos de
# aceptado/rechazado/listo que le devuelve. Debe ser igual a KITCHAN_BOT_SECRET
# del .env del bot. Generar con: python -c "import secrets;print(secrets.token_hex(32))"
WHATSAPP_BOT_SECRET=
# URL base del bot (donde KITCHAN lo llama de vuelta).
WHATSAPP_BOT_URL=http://127.0.0.1:8001
# Mapeo store_id del bot (KITCHAN_STORE_ID en su .env) -> restaurante_id, JSON.
# Ej: {"default": "11111111-1111-1111-1111-111111111111"}
WHATSAPP_STORE_ID_MAP={}

# --- Integración Rappi ---
# Credenciales client-credentials que Rappi entrega tras el alta manual.
RAPPI_CLIENT_ID=
RAPPI_CLIENT_SECRET=
# TODO: confirmar con Rappi si el login de integraciones exige `audience`.
RAPPI_AUDIENCE=
# Secreto que Rappi devuelve al crear el webhook; firma el header
# Rappi-Signature (HMAC-SHA256 sobre "<t>.<body>").
RAPPI_WEBHOOK_SECRET=
# Dominio de auth (dev: https://api.dev.rappi.com; Ecuador prod:
# https://api.rappi.com.ec) y dominio de la API de pedidos (dev:
# https://microservices.dev.rappi.com; el productivo lo confirma Rappi).
RAPPI_AUTH_BASE=https://api.dev.rappi.com
RAPPI_API_BASE=https://microservices.dev.rappi.com
# Mapeo estático store_id de Rappi (store.internal_id) -> restaurante_id
# interno de KITCHAN, en formato JSON.
# Ej: {"900123456": "11111111-1111-1111-1111-111111111111"}
RAPPI_STORE_ID_MAP={}

# --- Reportes ---
# Zona horaria del restaurante: define qué es "hoy" y las horas pico del dashboard.
# Los pedidos se guardan en UTC. Requiere el paquete tzdata (ver requirements.txt).
KITCHAN_ZONA_HORARIA=America/Guayaquil

# --- Rappi OAuth del comercio (modulo Self Onboarding del Integrations Portal) ---
# Client ID que muestra el modulo y redirect_uri registrada ahi tal cual (https).
RAPPI_OAUTH_CLIENT_ID=
RAPPI_OAUTH_REDIRECT_URI=https://TU-DOMINIO/api/v1/integraciones/rappi/auth/callback
# Opcionales (por defecto, el entorno de desarrollo de Rappi):
# RAPPI_OAUTH_AUTHORIZE_URL=https://login.partners.dev.rappi.com/authorize
# RAPPI_OAUTH_TOKEN_URL=https://login.partners.dev.rappi.com/oauth/token

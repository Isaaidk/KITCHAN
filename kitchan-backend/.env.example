# Copiar como .env y completar con valores reales. No commitear el .env real.

# --- Core / Base de datos ---
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/kitchan

# --- Core / Seguridad (JWT de sesión de KITCHAN) ---
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Infraestructura compartida ---
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173

# --- Integración Odoo (facturación) ---
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# --- Integración Uber Eats ---
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_WEBHOOK_SECRET=
UBER_REDIRECT_URI=

# --- Integración PedidosYa (Delivery Hero) ---
# Secreto compartido (HS512) que Delivery Hero entrega para firmar el JWT
# Bearer de cada llamada a nuestro endpoint de dispatch. Es distinto en
# staging y en producción.
PEDIDOSYA_JWT_SECRET=
# Credenciales asignadas durante el alta manual (NDA + formulario con el
# contacto de cuenta de PedidosYa) para las llamadas salientes al
# Integration Middleware API.
# TODO: confirmar el mecanismo real de auth contra pos-middleware-api (se
# asume Basic Auth como placeholder razonable).
PEDIDOSYA_PLUGIN_USERNAME=
PEDIDOSYA_PLUGIN_PASSWORD=
# Dominio del Integration Middleware API. Por defecto usa el de staging
# documentado (integration-middleware.stg.restaurant-partners.com);
# reemplazar por el productivo cuando el contacto de cuenta lo entregue.
PEDIDOSYA_API_BASE=https://integration-middleware.stg.restaurant-partners.com
# Mapeo estático remoteId (elegido por nosotros durante el alta manual) ->
# restaurante_id interno de KITCHAN, en formato JSON.
# Ej: {"POS_RESTAURANT_0001": "11111111-1111-1111-1111-111111111111"}
PEDIDOSYA_REMOTE_ID_MAP={}
